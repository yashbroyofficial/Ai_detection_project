# Copy to .env in the project root. Use your laptop's actual Wi-Fi/Ethernet IP.
PUBLIC_ORIGIN=https://192.168.1.25:5173
# Backend stays on loopback. Vite exposes HTTPS and proxies API + signaling.
HOST=127.0.0.1
PORT=3001
TLS_CERT_FILE=certs/lan.pem
TLS_KEY_FILE=certs/lan-key.pem
# Additional exact origins, comma-separated. Development also permits HTTPS
# localhost and 127.0.0.1; PUBLIC_ORIGIN is always included.
# ALLOWED_ORIGINS=https://camera-dev.example.test:5173
# Public, unauthenticated STUN URLs only. Do not put TURN secrets in frontend env.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
MAX_SESSIONS=500
